# Copy this file to .env (at the REPOSITORY ROOT) and adjust as needed.
# The backend reads dotenv from the root working directory, so PORT /
# CORS_ORIGIN live in the same root .env that Vite reads for VITE_API_URL.

# Backend HTTP port
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Use * during development to allow any origin.
CORS_ORIGIN=*

# The frontend dev server calls the API through this base URL.
VITE_API_URL=http://localhost:5000/api
